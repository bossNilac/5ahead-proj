{
  "expo": {
    "name": "PLCR",
    "slug": "ar-placement",
    "version": "1.0.0",
    "orientation": "portrait",
    "ios": {
      "bundleIdentifier": "com.calinbaculescu.fiveahead.arplacement",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Use the camera to position a container footprint and measure ground contact points.",
        "NSPhotoLibraryUsageDescription": "Allow $(PRODUCT_NAME) to access your photos",
        "NSPhotoLibraryAddUsageDescription": "Allow $(PRODUCT_NAME) to save photos",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to use your microphone",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      [
        "@reactvision/react-viro",
        {
          "ios": {
            "cameraUsagePermission": "Use the camera to position a container footprint and measure ground contact points."
          }
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "a35c8e96-890e-4cdb-adad-6ff239f2104e"
      }
    },
    "userInterfaceStyle": "automatic"
  }
}
